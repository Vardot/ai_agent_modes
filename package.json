{
  "name": "ai_agent_modes",
  "description": "Varbase E2E (Playwright + Cucumber) BDD suite for the AI Agent Modes Drupal module, tested against Drupal CMS.",
  "license": "GPL-2.0",
  "private": true,
  "author": "Rajab Natshah",
  "engines": {
    "yarn": ">= 1.6",
    "node": ">= 22.0"
  },
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js --no-ignore tests/step-definitions",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "drupal",
    "drupal-module",
    "ai",
    "ai-agents",
    "canvas"
  ],
  "dependencies": {
    "@vardot/varbase-e2e": "~2.0.1"
  },
  "devDependencies": {
    "@cucumber/pretty-formatter": "^3.3",
    "eslint": "~8",
    "eslint-config-prettier": "~8"
  },
  "resolutions": {
    "@cucumber/pretty-formatter": "^3.3"
  }
}